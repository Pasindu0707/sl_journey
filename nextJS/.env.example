# Copy to .env.local for local development. Both variables are optional.
#
# NEXT_PUBLIC_* values are inlined into the client bundle and are PUBLIC.
# Never put anything genuinely secret in one.

# Optional override for the Web3Forms access key. A working key is already
# committed as the default in src/data/site.ts (public by design), so the form
# emails enquiries out of the box. Only set this to point a different environment
# at a different key. Register the key to hello@sljourney.com in the Web3Forms
# dashboard so enquiries land there.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Leave unset for the custom domain (sljourney.com), which serves from the root.
# Only set this to deploy back to a project subpath, e.g. /sl_journeys for
# <user>.github.io/sl_journeys.
# NEXT_PUBLIC_BASE_PATH=
